 local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/kirsia-dev/Zuperming/refs/heads/main/ZuperMingGUI.lua"))()

Library:SetTheme("Grey")

Library:SetNotification({
    Title = "ZuperMing",
    Description = "| Example",
    Content = "Script loaded successfully!",
    Time = 0.5,
    Delay = 5,
})

local MainWindow = Library:CreateWindow({
    Title = "ZuperMing",
    Description = "| UI Develoment",
    ["Tab Width"] = 120,
    Acrylic = false,
    Theme = "Grey"
})

local Tabs = {
    Settings = MainWindow:CreateTab({ Name = "Settings", Icon = "settings" }),
    Paragraph = MainWindow:CreateTab({ Name = "Paragraph", Icon = "pilcrow" }),
    Notify = MainWindow:CreateTab({ Name = "Notify", Icon = "bell" }),
    Button = MainWindow:CreateTab({ Name = "Button", Icon = "mouse" }),
    Toggle = MainWindow:CreateTab({ Name = "Toggle", Icon = "toggle-left" }),
    Input = MainWindow:CreateTab({ Name = "Input", Icon = "rectangle-ellipsis" }),
    Slider = MainWindow:CreateTab({ Name = "Slider", Icon = "sliders-horizontal" }),
    Dropdown = MainWindow:CreateTab({ Name = "Dropdown", Icon = "chevron-down" }),
    Keybind = MainWindow:CreateTab({ Name = "Keybind", Icon = "keyboard" }),
}

-- [[ Settings ]]
local SettingsSection = Tabs.Settings:AddSection("Settings", true)

SettingsSection:AddDropdown({
    Title = "Theme",
    Content = "Pilih warna tema UI",
    Default = {"Grey"},
    Options = Library:GetThemes(),
    Multi = false,
    Callback = function(Value)
        local selected = type(Value) == "table" and Value[1] or Value
        if selected and selected ~= "" then
            Library:SetTheme(selected)
        end
    end,
})

local toggleKey = Enum.KeyCode.RightShift

SettingsSection:AddKeybind({
    Title = "Toggle UI",
    Default = Enum.KeyCode.RightShift,
    InputType = "Keyboard",
    Callback = function(Key)
        toggleKey = Key
    end,
})

